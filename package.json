{
  "name": "pickadate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "auth:keys": "node scripts/generate-convex-auth-keys.mjs",
    "auth:keys:sync": "node scripts/generate-convex-auth-keys.mjs --set-convex",
    "auth:keys:push": "node scripts/generate-convex-auth-keys.mjs --sync-existing",
    "convex:env:sync": "node scripts/sync-convex-env.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.1 <13"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.96",
    "@phosphor-icons/react": "2.1.10",
    "convex": "1.48.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.35.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "convex-test": "0.0.66",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "jose": "6.2.14",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "esbuild@0.27.0": true,
    "unrs-resolver@1.12.2": true
  }
}
